    Item[0]     =      0x800b;        1;      20   #Front common video
    Item[1]     =      0x802b;        1;      20   #Front EIS
    Item[2]     =      0x800b;        0;      24   #Main video
    Item[3]     =      0x800b;        2;      24   #ultra Wide video
    Item[4]     =      0x800b;        3;      24   #Tele video
    Item[5]     =      0x800b;        4;      24   #Tele2 video
    Item[6]     =      0x80A7;        1;      20   #Front HDR video
    Item[7]     =      0x8021;        1;      24   #Front 60fps video

[StabilityDebug]
    #Trigger SOF WatchDog Timeout Threshold       operation_mode  is_realtime_pipeline   threshold
    watchDogTimeoutThreshold[0]           =      0x8019;              1;                 10           #SuperNight Realtime Pipeline
    watchDogTimeoutThreshold[1]           =      0x8001;              1;                 5            #photo mode

[IsNeedOverrideToFullRecovery]
     isEnable = TRUE

[RawSnapshot]
    apsfeaturetype  =  3;  48;   49;   50;   51;   52;   56;  59;  64;  61;  62;  63;  66;  67

[IzoomSnapshot]
    apsfeaturetype  =  49;  52;   54;   56;   62;   64;   65;  66;  74;  78

[SupportedFactoryJpegSizes]
    ImageSizes[0]  =  4160; 3120
    ImageSizes[1]  =  3264; 2448

[SupportedCustomRawSizes]
    ImageSizes[0]  =  4160; 3120
    ImageSizes[1]  =  3264; 2448

[SupportedQCFAImageSizeserhaimain]
    ImageSizes[0]  = 4160;  3120    # main camera full size


[UHPRawSize]
    ImageSize  = 8192;  6144

[EISTypeMatching]
    #VideoEisMode    captureMode  sensorlist
    Mode[0]     =      0x800B;    erhaimain;          #720P 1080P SINGLE 30FPS QCOM_EIS3 rear VIDEO
    Mode[1]     =      0x8028;    erhaimain;          #1080P SINGLE 30FPS SUPEREIS3 rear VIDEO
    Mode[2]     =      0x802B;    erhaifront;         #720P 1080P SINGLE 30FPS SUPEREIS3 FRONT VIDEO
    Mode[3]     =      0x80A7;    erhaimain;         #720P 1080P SINGLE 30FPS SUPEREIS3 FRONT VIDEO

[EISJsonInit]
     EISCameraID[0]          =     0     #CAMERA_ID_NFOV
     EISCameraID[1]          =     1     #CAMERA_ID_WFOV

[EisModeTable]
    #eisModeTable        numOfLinkedCameras       captureMode      cameraType           eisMode
    eisModeTable[0]     =    1;                     0x8028;          System;             Super_EIS;
    eisModeTable[1]     =    1;                     0x802B;          System;             Super_EIS;
    eisModeTable[2]     =    1;                     0x800B;          System;             Super_EIS_30FPS;
    eisModeTable[3]     =    1;                     0x0;             3rdCamera;          Night_HDR_EIS_3rdCamera

[OPlusEISSettings]
    #enable DynamicOISMode
    Disable_EIS_CFG_LDC_MODE = FALSE
    enableSysReadoutMask = 0x0A
    NeedDynamicOISMode = FALSE
    NeedDynamicSOISMode = FALSE
    EnableImageNativeHandle = TRUE
    EnableRectBaseOutFrame  = TRUE
    isEnableSecondMainIzoomId = TRUE
    ImageNativeHandleEnableRatio = 3.0
    DisableTeleFeatureRatio = 6.0
    #enableLongExpMask = 0x04
    isNeedLagCoeffsSHDR = TRUE
    IMUlagCoeffsSHDR = 0; 0; 0; -16000; 0;
    OISIMUlagCoeffsSHDR = 0; 0; 0; -16000; 0;
    ImageOnOperationMode = 0x8001;0x8019;
    opertionMode = 0x8021;0x8028;0x830B;0x830C;0x80A4;0x80A5;0x4000830B;0x400080A4;0x4000800B;
    #operation mode     operation_mode   ExposureThreshold    delaycntThreshold
    Mode[0]        =     0x8021;             3000000;                 60           #COMMON 60fps VIDEO
    Mode[1]        =     0x8028;             3000000;                 60           #SUPEREIS VIDEO
    Mode[2]        =     0x830B;             3000000;                 30           #COMMON VIDEO
    Mode[3]        =     0x830C;             3000000;                 30           #FastVideo EIS
    Mode[4]        =     0x80A4;             3000000;                 30           #MOVIE VIDEO
    Mode[5]        =     0x80A5;             3000000;                 30           #Hyperlapse VIDEO
    Mode[6]        =     0x8001;             3000000;                 30           #QuickVideo

